# Configuración Nginx para Klase A Panel
# Este es un archivo de ejemplo para usar con Nginx en lugar de Apache

server {
    listen 80;
    listen [::]:80;
    
    server_name panel.klasea.com;
    root /var/www/html/klasea;
    
    index index.php index.html;
    
    # Logs
    access_log /var/log/nginx/klasea_access.log;
    error_log /var/log/nginx/klasea_error.log;
    
    # Seguridad: prevenir acceso a archivos sensibles
    location ~ /\. {
        deny all;
    }
    
    location ~ ^/(php|database|tools)/ {
        deny all;
    }
    
    location ~ config\.php$ {
        deny all;
    }
    
    # Procesar PHP
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;  # Ajustar versión de PHP
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }
    
    # Manejo de URLs limpias
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
    
    # Cache para recursos estáticos
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    
    # Headers de seguridad
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    
    # Desactivar logs para archivos estáticos
    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }
    
    location = /robots.txt {
        access_log off;
        log_not_found off;
    }
}

